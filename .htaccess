AddDefaultCharset UTF-8

<IfModule mod_rewrite.c>

# Enable rewrite rules
RewriteEngine on

# Base directory
RewriteBase /

# Live site only: send www. and http:// to https://nyssen.me.
# Both rules check the host, so the local http://nyssen/ is not redirected.
RewriteCond %{HTTP_HOST} ^www\.nyssen\.me$ [NC]
RewriteRule ^ https://nyssen.me%{REQUEST_URI} [R=301,L]

RewriteCond %{HTTP_HOST} ^nyssen\.me$ [NC]
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^ https://nyssen.me%{REQUEST_URI} [R=301,L]

# Deny direct access to the next directories
RewriteRule ^bl-content/(databases|workspaces|pages|tmp)/.*$ - [R=404,L]

# All URL process by index.php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*) index.php [PT,L]

</IfModule>

# Security headers for every response, including the admin and static files.
# The Content-Security-Policy is sent by the theme (bl-themes/ny/index.php),
# because it depends on the theme's inline scripts and would break the admin.
# Browsers ignore Strict-Transport-Security over plain http://, so it is safe locally.
<IfModule mod_headers.c>
Header always set Strict-Transport-Security "max-age=31536000"
Header always set X-Content-Type-Options "nosniff"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()"
Header always unset X-Powered-By
Header unset X-Powered-By
</IfModule>
